# Copy this file to .env and replace the required blank values before starting Compose.
# Use a password manager or a cryptographically secure generator; never commit .env.

# Database and application secrets (required)
SQL_PASSWORD=
# Use at least 32 UTF-8 bytes.
JWT_KEY=
# Used only when the database has no Admin; 16–72 UTF-8 bytes.
ADMIN_SEED_PASSWORD=
BILLING_SERVICE_KEY=

# Internal infrastructure credentials (required)
RABBITMQ_USER=
RABBITMQ_PASS=
REDIS_PASSWORD=

# Public frontend origin accepted by Backend and Gateway CORS
FRONTEND_ORIGIN=http://localhost:3000

# Optional shared password for seeded demo member accounts; if set, use 16–72 UTF-8 bytes.
# If blank, the accounts receive a random password that is not logged.
DEMO_MEMBER_PASSWORD=

# Local development host ports
SQL_PORT=1433
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
GATEWAY_PORT=8000
FRONTEND_PORT=3000

# Optional SMTP delivery (Notification Service)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=concierge@jamesthew-culinary.com
SMTP_FROM_NAME=Chef James Thew Culinary Atelier
SMTP_ENABLE_SSL=true

# Optional Cloudinary upload configuration; uploads return 503 until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SIGNATURE_ALGORITHM=SHA1
