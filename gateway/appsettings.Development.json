          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "contest-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "community-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5008"
          }
        }
