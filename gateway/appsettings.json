        "ClusterId": "community-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/recipes/share-counts"
        }
      },
      "notification-hub-route": {
        "ClusterId": "notification-cluster",
        "Order": -1,
        "Match": {
          "Path": "/hub/notifications/{**catch-all}"
        }
      },
      "notification-hub-root-route": {
        "ClusterId": "notification-cluster",
        "Order": -2,
        "Match": {
          "Path": "/hub/notifications"
        }
      },
      "recipes-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/recipes/{**catch-all}"
        }
      },
      "recipes-root-route": {
        "ClusterId": "catalog-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/recipes"
        }
      },
      "versioned-recipes-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/recipes/{**catch-all}"
        }
      },
      "versioned-recipes-root-route": {
        "ClusterId": "catalog-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/recipes"
        }
      },
      "tips-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/tips/{**catch-all}"
        }
      },
      "tips-root-route": {
        "ClusterId": "catalog-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/tips"
        }
      },
      "versioned-tips-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/tips/{**catch-all}"
        }
      },
      "versioned-tips-root-route": {
        "ClusterId": "catalog-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/tips"
        }
      },
      "categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "categories-root-route": {
        "ClusterId": "catalog-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/categories"
        }
      },
      "versioned-categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}"
        }
      },
      "versioned-categories-root-route": {
        "ClusterId": "catalog-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/categories"
        }
      },
      "faqs-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/faqs/{**catch-all}"
        }
      },
      "faqs-root-route": {
        "ClusterId": "catalog-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/faqs"
        }
      },
      "versioned-faqs-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/faqs/{**catch-all}"
        }
      },
      "versioned-faqs-root-route": {
        "ClusterId": "catalog-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/faqs"
        }
      }
    },
    "Clusters": {
      "backend-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://backend:5000"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://backend:5000"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://backend:5000"
          }
        }
      },
      "media-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://backend:5000"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://backend:5000"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://backend:5000"
          }
        }
      },
      "contest-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://backend:5000"
          }
        }
      },
      "community-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://backend:5000"
          }
        }
      }
    }
  }
}

