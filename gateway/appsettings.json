{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "JamesThewCookingSecretKeyForJwtTokenAuth2026!#*VeryLongSecretKeyMustBe32BytesOrMore",
    "Issuer": "JamesThewApi",
    "Audience": "JamesThewClient"
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "swagger-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/swagger/{**catch-all}"
        }
      },
      "signalr-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/hub/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notifications-root-route": {
        "ClusterId": "notification-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/notifications"
        }
      },
      "notification-hub-route": {
        "ClusterId": "notification-cluster",
        "Order": -1,
        "Match": {
          "Path": "/hub/notifications/{**catch-all}"
        }
      },
      "notification-hub-root-route": {
        "ClusterId": "notification-cluster",
        "Order": -2,
        "Match": {
          "Path": "/hub/notifications"
        }
      }
    },
    "Clusters": {
      "backend-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://backend:5000"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://notification-service:5007"
          }
        }
      }
    }
  }
}

