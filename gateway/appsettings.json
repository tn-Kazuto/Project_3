{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "JamesThewCookingSecretKeyForJwtTokenAuth2026!#*VeryLongSecretKeyMustBe32BytesOrMore",
    "Issuer": "JamesThewApi",
    "Audience": "JamesThewClient"
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "swagger-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/swagger/{**catch-all}"
        }
      },
      "signalr-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/hub/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "backend-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://backend:5000"
          }
        }
      }
    }
  }
}

