{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:13000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "swagger-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/swagger/{**catch-all}"
        }
      },
      "signalr-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/hub/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notifications-root-route": {
        "ClusterId": "notification-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/notifications"
        }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/media/{**catch-all}"
        }
      },
      "media-root-route": {
        "ClusterId": "media-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/media"
        }
      },
      "billing-subscriptions-route": {
        "ClusterId": "billing-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/subscriptions/{**catch-all}"
        }
      },
      "billing-subscriptions-root-route": {
        "ClusterId": "billing-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/subscriptions"
        }
      },
      "billing-payments-route": {
        "ClusterId": "payment-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "billing-payments-root-route": {
        "ClusterId": "payment-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/payments"
        }
      },
      "contests-route": {
        "ClusterId": "contest-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/contests/{**catch-all}"
        }
      },
      "contests-root-route": {
        "ClusterId": "contest-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/contests"
        }
      },
      "announcements-route": {
        "ClusterId": "contest-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/announcements/{**catch-all}"
        }
      },
      "announcements-root-route": {
        "ClusterId": "contest-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/announcements"
        }
      },
      "feedbacks-route": {
        "ClusterId": "community-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/feedbacks/{**catch-all}"
        }
      },
      "feedbacks-root-route": {
        "ClusterId": "community-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/feedbacks"
        }
      },
      "versioned-feedbacks-route": {
        "ClusterId": "community-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/feedbacks/{**catch-all}"
        }
      },
      "versioned-feedbacks-root-route": {
        "ClusterId": "community-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/feedbacks"
        }
      },
      "recipe-comments-route": {
        "ClusterId": "community-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/recipes/{recipeId:int}/comments/{**catch-all}"
        }
      },
      "recipe-comments-root-route": {
        "ClusterId": "community-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/recipes/{recipeId:int}/comments"
        }
      },
      "versioned-recipe-comments-route": {
        "ClusterId": "community-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/recipes/{recipeId:int}/comments/{**catch-all}"
        }
      },
      "versioned-recipe-comments-root-route": {
        "ClusterId": "community-cluster",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/recipes/{recipeId:int}/comments"
        }
      },
      "recipe-share-route": {
        "ClusterId": "community-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/recipes/{recipeId:int}/share"
        }
